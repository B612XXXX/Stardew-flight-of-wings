<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net6.0</TargetFramework><LangVersion>12</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><CheckEolTargetFramework>false</CheckEolTargetFramework>
    <AngelWingsProfile Condition="'$(AngelWingsProfile)' == ''">QuickTest</AngelWingsProfile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AngelWingsProfile)' == 'Formal'">
    <DefineConstants>$(DefineConstants);ANGELWINGS_FORMAL</DefineConstants>
    <OutputPath>bin/$(Configuration)/formal/</OutputPath>
    <IntermediateOutputPath>obj/$(Configuration)/formal/$(TargetFramework)/</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/AngelWings.VisualPreview/AngelWings.VisualPreview.csproj" />
    <Reference Include="Stardew Valley"><HintPath>$(GamePath)/Stardew Valley.dll</HintPath></Reference>
    <Reference Include="StardewValley.GameData"><HintPath>$(GamePath)/StardewValley.GameData.dll</HintPath></Reference>
    <Reference Include="MonoGame.Framework"><HintPath>$(GamePath)/MonoGame.Framework.dll</HintPath></Reference>
    <Reference Include="xTile"><HintPath>$(GamePath)/xTile.dll</HintPath></Reference>
    <Reference Include="StardewModdingAPI"><HintPath>$(GamePath)/StardewModdingAPI.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(GamePath)/smapi-internal/0Harmony.dll</HintPath></Reference>
    <RuntimeHostConfigurationOption Include="System.Runtime.TieredCompilation" Value="false" />
  </ItemGroup>
</Project>
